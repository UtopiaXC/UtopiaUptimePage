# ===========================================
# Utopia Kuma Server Configuration
# ===========================================

# Path to Uptime Kuma's data directory (where kuma.db or db-config.json are located)
# When running in Docker, this should usually be /data
KUMA_DATA_PATH=./data

# Server settings
UTOPIA_PORT=55520
UTOPIA_HOST=0.0.0.0

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=60

# CORS allowed origins (comma-separated, * = allow all)
CORS_ORIGINS=*

# Enable database mode (set to false for proxy-only mode)
ENABLE_DB_MODE=true

# Allowed proxy target URLs (comma-separated)
# Leave empty to allow all URLs (not recommended for production)
# Example: http://192.168.2.6:3001,https://kuma.example.com
ALLOWED_PROXY_TARGETS=
